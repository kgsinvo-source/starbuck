$valid_password_hash = '$2y$10$tM0OQxT3E6gXpYv6gR3jO.123456789012345678901234567890'; // Це хеш для 'password123'

$error = '';

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $input_username = $_POST['username'] ?? '';
    $input_password = $_POST['password'] ?? '';

    // Перевірка імені користувача та пароля
    if ($input_username === $valid_username && password_verify($input_password, $valid_password_hash)) {
        
        // Аутентифікація успішна
        $_SESSION['logged_in'] = true;
        $_SESSION['username'] = $valid_username; // Можна зберегти ім'я
        
        // Перенаправлення на головну сторінку адмін-панелі
        header('Location: index.php');
        exit();
