body {
    font-family: Arial, sans-serif;
    background: #f6f2ee;
    margin: 0;
    color: #3b2f2f;
}

header {
    background: #4b2e2b;
    color: #fff;
    padding: 20px;
    text-align: center;
}

.container {
    max-width: 900px;
    margin: auto;
    padding: 20px;
}

h2 {
    margin-top: 30px;
    color: #4b2e2b;
}

.product {
    background: #fff;
    padding: 15px;
    border-radius: 10px;
    margin-bottom: 20px;
    box-shadow: 0 2px 6px rgba(0,0,0,0.1);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 18px;
}

button {
    background: #7a4f38;
    color: #fff;
    padding: 10px 18px;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: 0.2s;
}

button:hover {
    background: #5f3c2c;
}

#cart-items {
    margin-top: 10px;
    padding: 15px;
    background: #fff;
    border-radius: 10px;
    box-shadow: 0 2px 6px rgba(0,0,0,0.1);
    font-size: 18px;
}

#reviews {
    background: #fff;
    padding: 15px;
    border-radius: 10px;
    margin-top: 10px;
    box-shadow: 0 2px 6px rgba(0,0,0,0.1);
}

.review {
    background: #f1e9e5;
    padding: 10px;
    margin-bottom: 10px;
    border-radius: 8px;
}

input, textarea {
    width: 100%;
    padding: 10px;
    margin-top: 10px;
    border-radius: 8px;
    border: 1px solid #ccc;
    font-size: 16px;
}

textarea {
    resize: vertical;
}
